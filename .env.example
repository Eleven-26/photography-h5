# 环境变量模板 —— 复制为 .env.development / .env.production 后按环境填写
# （本仓 .gitignore 忽略 .env 与 .env.*，仅保留本模板，故实际取值文件不入库）
#
# H5 端后端基址：留空 = 同源相对路径
#   开发 → Vite devServer 把 /api 代理到该地址并剥离 /api（见 vite.config.js）
#   生产 → 留空，由容器 nginx 把 /api 反代到 backend:8080（见 build/nginx.conf）
VITE_API_BASE_URL=
#
# 小程序端后端基址：**无代理，必须直连后端源**，须为 https 且不带路径
#   开发 → http://localhost:8080（真机联调必须改成电脑局域网 IP，如 http://192.168.1.10:8080
#          —— 真机上 localhost 指向手机自身，必然连不上）
#   生产 → 微信公众平台「开发管理 → 服务器域名」配置的 request 合法域名，如 https://api.slot.com
VITE_MP_API_BASE_URL=
#
# 占位（设计稿）数据兜底开关 —— 不填 = 关闭（默认关闭，推荐）
#   开启（true）后，页面在接口无数据时才用画板导出的占位图与文案顶上，仅用于视觉走查。
#   ⚠️ 排查「页面数据不对」时必须保持关闭：开启会把「接口没返回真实数据」伪装成「页面正常」。
#      2026-09-14 套餐列表就是因为这个兜底默认开着，导致真实原因（分页结构读错 + 状态口径反了）
#      被掩盖成"接口没接"。
VITE_ALLOW_DEMO=false
